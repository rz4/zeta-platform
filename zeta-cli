#!/usr/bin/env bash
# the `zeta` command -- runs the SDK from anywhere; prefers the repo's
# own .venv when one exists, falls back to the system python
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
exec "$PY" -m zeta.cli "$@"

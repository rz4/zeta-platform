; cube.zol -- the first 3D cart: a flat-shaded cube driving
; around a checkered plane. GENERATED by carts/witness/gen_cube.py --
; edit that, not this. Arrows drive, the cube spins itself.
;
; GEOM does the rest: camera cells 8..11 are set once by .data,
; the object list at 14084 points at the two meshes below, and
; the per-frame program only writes the cube's pose.

.const PAD 1
.const X 16
.const Z 17
.const YAW 18

.data 16 0 131072 0        ; cube starts 2 units out
.data 8 0 91750 -196608 0  ; camera: x 0, y 1.4, z -3, yaw 0
.data 14484 38448 6  ; a 110 Hz triangle hum, always on

; object list: 2 objects (ground at 512, cube at 1100)

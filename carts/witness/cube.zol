; ---- drive: arrows slide the cube, and it always spins ------------------
load PAD
push 8                     ; RIGHT
and
jz no_r
load X
push 3277                  ; 0.05 units
add
store X
no_r:
load PAD
push 4                     ; LEFT
and
jz no_l
load X
push 3277
sub
store X
no_l:
load PAD
push 1                     ; UP: away from camera
and
jz no_u
load Z
push 3277
add
store Z
no_u:
load PAD
push 2                     ; DOWN
and
jz no_d
load Z
push 3277
sub
store Z
no_d:
load YAW
push 6
add
store YAW

; ---- object list: the cube's live pose (ground's entry is all .data) ----
load X
store 14092                 ; obj1 x
load Z
store 14094                 ; obj1 z
load YAW
store 14095                 ; obj1 yaw
halt

; ---- pick: A wants the cube (1), B the bunny (0); an unloaded
; ---- machine (WANT<0) wants the bunny. A change starts PHASE. --
load WANT
store PICK
load PAD
push 16
and
jz not_a
push 1
store PICK
not_a:
load PAD
push 32
and
jz not_b
push 0
store PICK
not_b:
load WANT
push 0
lt
jz have
push 0
store PICK
have:
; ---- boot: page EVERYTHING once (bunny + cube, own slots);
; ---- afterwards A/B are pure display flips -- no mover, ever --
load WANT
push 0
lt
jz not_boot
push 4
store PHASE
push 0
store IDX
push 0
store WANT
not_boot:
load PHASE
jz flips
load IDX
push 3
mul
push 80
add
dup
loadi
store SRC
dup
push 1
add
loadi
store DST
push 2
add
loadi
store LEN
push 1
store GO
load IDX
push 1
add
store IDX
load PHASE
push 1
sub
store PHASE
jmp drive
flips:
load PICK
store WANT
load WANT
jz show_bunny
push 5386
store 14091
push 1
store 14096
push 2
store 14084
jmp drive
show_bunny:
push 900
store 14091
push 3
store 14096
push 4
store 14084
drive:
load PAD
push 8
and
jz n_r
load X
push 3277
add
store X
n_r:
load PAD
push 4
and
jz n_l
load X
push 3277
sub
store X
n_l:
load PAD
push 1
and
jz n_u
load Z
push 3277
add
store Z
n_u:
load PAD
push 2
and
jz n_d
load Z
push 3277
sub
store Z
n_d:
load YAW
push 3
add
store YAW
load X
store 14092
load Z
store 14094
load YAW
store 14095
load X
store 14098
load Z
store 14100
load YAW
store 14101
load X
store 14104
load Z
store 14106
load YAW
store 14107
halt
; tear.zol -- TEAR, the fight, in pure ZOL. You (blue) vs the machine (red).
;
;   move: .oeu or arrows     jab: n (A)     heavy: h (B)
;   block: hold AWAY from the machine with your hands free
;
; THE FRAME DATA (stage 1 of FLAGSHIP.md -- the fight grows teeth):
;
;   move    total  startup  active at  damage  reach  knockback
;   JAB       14      4     timer==10     8      52      18
;   HEAVY     26     14     timer==12    20      56      30
;
; and the triangle that makes a fight out of it:
;   JAB beats HEAVY    a hit landed during a wind-up CANCELS the move,
;                      and the heavy's wind-up is 14 readable frames
;   BLOCK beats JAB    holding away with free hands turns a jab into
;                      2 chip, no knockback
;   HEAVY beats BLOCK  the heavy goes through a guard at full price
;
; A clean hit freezes both fighters for 6 frames (HITSTOP); a blocked
; one for 3. A button pressed mid-move is BUFFERED for 10 frames and
; fires the instant the hands are free. The machine walks in and swings
; every 32 frames, and every fourth swing is the heavy -- the wind-up
; you jab through.
;
; Empty a health bar and the round freezes on the winner's color, then
; resets. Game state in cells 16..35, a fixed 20-triangle display list
; at 12288 whose static words are .data and whose moving words are
; rewritten each frame. Hidden shapes park at x=-100 where the GPU's
; clipped bounding box skips them.

.const PAD 1
.const PX 16               ; player left edge
.const EX 17               ; enemy left edge
.const PH 18               ; player health 0..96
.const EH 19               ; enemy health
.const PP 20               ; player move timer, counts down to 0
.const EP 21               ; enemy move timer
.const PFL 22              ; player hit-flash frames
.const EFL 23              ; enemy hit-flash frames
.const KO 24               ; round-freeze countdown, 0 = fighting
.const WIN 25              ; 1 = player, 2 = enemy
.const FACE 26             ; 1 = player is left of enemy
.const DX 27               ; ex - px, signed
.const ADX 28              ; |dx|
.const T0 29               ; scratch
.const T1 30               ; scratch
.const PMV 31              ; player move: 0 none, 1 jab, 2 heavy
.const EMV 32              ; enemy move
.const PBUF 33             ; buffered move, fires when the hands free
.const BTIM 34             ; the buffer's 10-frame life
.const HST 35              ; hitstop: both fighters frozen while > 0
.const PAD2 12263          ; spec.REG_PAD2: the second pad (stage 2).
.const P2ON 36             ; a human has the red fighter. Latched by any
                           ; press on pad 2 and NEVER cleared: the
                           ; machine does not take the controller back.
.const EBUF 37             ; the red fighter's buffer, human mode only
.const EBTIM 38
.const PPV 39              ; last frame's pad words: a buffer accepts a
.const P2PV 40             ; FRESH press only -- a held button whiffing
                           ; forever at range was the bug this closes
.const PRW 41              ; rounds won (stage 3): first to two takes
.const ERW 42              ; the match
.const RT 43               ; the round timer, 3600 frames = one minute.
                           ; Hitstop skips the world, so it pauses the
                           ; clock for free. At zero the health lead
                           ; takes the round; a tie takes nothing.

.data 16 60 236 96 96 0 0 0 0 0 0 1 0 0
.data 41 0 0 3600

; ---- the fixed display list: 30 triangles, static words baked ------------
.data 12288 30
.data 12289 0 240 320 240 0 288 0x232B3A       ; floor
.data 12296 320 240 320 288 0 288 0x232B3A
.data 12303 0 176 0 176 0 240 0x3399FF         ; player body (x words live)
.data 12310 0 176 0 240 0 240 0x3399FF
.data 12317 0 176 0 176 0 240 0xEE4444         ; enemy body
.data 12324 0 176 0 240 0 240 0xEE4444
.data 12331 -100 196 -76 196 -100 208 0xFFD080 ; player fist (parked)
.data 12338 -76 196 -76 208 -100 208 0xFFD080
.data 12345 -100 196 -76 196 -100 208 0xFFB060 ; enemy fist (parked)
.data 12352 -76 196 -76 208 -100 208 0xFFB060
.data 12359 8 8 0 8 8 18 0x33FF88              ; player health bar
.data 12366 0 8 0 18 8 18 0x33FF88
.data 12373 0 8 312 8 0 18 0xFF6666            ; enemy health bar
.data 12380 312 8 312 18 0 18 0xFF6666
.data 12387 -100 168 -76 168 -100 248 0xFFFFFF ; player hit flash (parked)
.data 12394 -76 168 -76 248 -100 248 0xFFFFFF
.data 12401 -100 168 -76 168 -100 248 0xFFFFFF ; enemy hit flash (parked)
.data 12408 -76 168 -76 248 -100 248 0xFFFFFF
.data 12415 0 100 0 100 0 140 0                ; KO banner (winner's color)
.data 12422 0 100 0 140 0 140 0
.data 12429 0 9 0 9 0 17 0xFFFFFF              ; round timer (x words live)
.data 12436 0 9 0 17 0 17 0xFFFFFF
.data 12443 -100 22 -76 22 -100 28 0x3399FF    ; player round pips (parked)
.data 12450 -76 22 -76 28 -100 28 0x3399FF
.data 12457 -100 22 -76 22 -100 28 0x3399FF
.data 12464 -76 22 -76 28 -100 28 0x3399FF
.data 12471 -100 22 -76 22 -100 28 0xEE4444    ; enemy round pips (parked)
.data 12478 -76 22 -76 28 -100 28 0xEE4444
.data 12485 -100 22 -76 22 -100 28 0xEE4444
.data 12492 -76 22 -76 28 -100 28 0xEE4444

; ==== round freeze =========================================================
load KO
jz play
load KO
push 1
sub
store KO
load KO
jz do_reset
jmp aftermath
do_reset:
push 60
store PX
push 236
store EX
push 96
store PH
push 96
store EH
push 0
store PP
push 0
store EP
push 0
store PFL
push 0
store EFL
push 0
store WIN
push 0
store PMV
push 0
store EMV
push 0
store PBUF
push 0
store BTIM
push 0
store HST
push 0
store EBUF
push 0
store EBTIM
push 3600
store RT
push 1                     ; a finished MATCH resets the rounds too
load PRW
lt
jz r_chk_e
jmp r_fresh
r_chk_e:
push 1
load ERW
lt
jz r_rounds_done
r_fresh:
push 0
store PRW
push 0
store ERW
r_rounds_done:
jmp aftermath

; ==== the fight ============================================================
play:
load PAD2                  ; anyone on the second pad? (before the
jz p2_seen                 ; hitstop gate, so a press is never lost)
push 1
store P2ON
p2_seen:
load EX                    ; dx = ex - px, adx = |dx|, face = px < ex
load PX
sub
store DX
load DX
push 0
lt
jz dx_pos
push 0
load DX
sub
store ADX
push 0
store FACE
jmp dx_done
dx_pos:
load DX
store ADX
push 1
store FACE
dx_done:

; ---- hitstop: the connect freezes the WORLD, not the flash ------------------
load HST
jz hst_z
load HST
push 1
sub
store HST
jmp aftermath
hst_z:

; ---- the round clock: at zero the health lead takes the round ---------------
load RT
push 1
sub
store RT
load RT
jz rt_out
jmp rt_done
rt_out:
load EH
load PH
lt                         ; EH < PH: the player leads on points
jz rt_try_e
push 1
store WIN
load PRW
push 1
add
store PRW
push 120
store KO
push 1
load PRW
lt                         ; a second round ends the MATCH: a longer
jz rt_done                 ; freeze is the results screen
push 300
store KO
jmp rt_done
rt_try_e:
load PH
load EH
lt
jz rt_tie
push 2
store WIN
load ERW
push 1
add
store ERW
push 120
store KO
push 1
load ERW
lt
jz rt_done
push 300
store KO
jmp rt_done
rt_tie:
push 0                     ; a dead-even clock takes nothing: the round
store WIN                  ; replays, and the banner says so in gray
push 90
store KO
rt_done:

; ---- player: mid-move ticks down (presses buffer), else act -----------------
load PP
jz p_free
load PAD                   ; a FRESH press made mid-move is held ten
push 16                    ; frames and fires the instant the hands free
and
jz p_bufa_no
load PPV
push 16
and
jz p_bufa_set
jmp p_bufa_no
p_bufa_set:
push 1
store PBUF
push 10
store BTIM
p_bufa_no:
load PAD
push 32
and
jz p_bufb_no
load PPV
push 32
and
jz p_bufb_set
jmp p_bufb_no
p_bufb_set:
push 2
store PBUF
push 10
store BTIM
p_bufb_no:
load PP
push 1
sub
store PP
load PP
jz p_move_end
jmp p_done
p_move_end:
push 0
store PMV
jmp p_done
p_free:
load BTIM                  ; the buffer ages while the hands are free
jz p_buf_dead
load BTIM
push 1
sub
store BTIM
load PBUF
jz p_input
load PBUF
push 2
eq
jz p_buf_jab
push 0
store PBUF
jmp p_heavy
p_buf_jab:
push 0
store PBUF
jmp p_jab
p_buf_dead:
push 0
store PBUF
p_input:
load PAD
push 8                     ; RIGHT
and
jz p_no_r
load PX
push 2
add
store PX
p_no_r:
load PAD
push 4                     ; LEFT
and
jz p_no_l
load PX
push 2
sub
store PX
p_no_l:
load PAD
push 16                    ; A: the jab
and
jz p_try_b
p_jab:
push 1
store PMV
push 14
store PP
jmp p_done
p_try_b:
load PAD
push 32                    ; B: the heavy -- 14 frames of wind-up,
and                        ; and it goes through a guard
jz p_done
p_heavy:
push 2
store PMV
push 26
store PP
p_done:

; ---- enemy: the same body; the soul is the AI's until a human takes it ------
load EP
jz e_free
load PAD2                  ; a human's FRESH press made mid-move
push 16                    ; buffers, as the blue side's does
and
jz e_bufa_no
load P2PV
push 16
and
jz e_bufa_set
jmp e_bufa_no
e_bufa_set:
push 1
store EBUF
push 10
store EBTIM
e_bufa_no:
load PAD2
push 32
and
jz e_bufb_no
load P2PV
push 32
and
jz e_bufb_set
jmp e_bufb_no
e_bufb_set:
push 2
store EBUF
push 10
store EBTIM
e_bufb_no:
load EP
push 1
sub
store EP
load EP
jz e_move_end
jmp e_done
e_move_end:
push 0
store EMV
jmp e_done
e_free:
load P2ON
jz e_ai
; ---- the second human -------------------------------------------------------
load EBTIM
jz e_buf_dead
load EBTIM
push 1
sub
store EBTIM
load EBUF
jz e_input
load EBUF
push 2
eq
jz e_buf_jab
push 0
store EBUF
jmp e_heavy
e_buf_jab:
push 0
store EBUF
jmp e_jab
e_buf_dead:
push 0
store EBUF
e_input:
load PAD2
push 8                     ; RIGHT
and
jz e2_no_r
load EX
push 2
add
store EX
e2_no_r:
load PAD2
push 4                     ; LEFT
and
jz e2_no_l
load EX
push 2
sub
store EX
e2_no_l:
load PAD2
push 16                    ; A: the jab
and
jz e2_try_b
jmp e_jab
e2_try_b:
load PAD2
push 32                    ; B: the heavy
and
jz e_done
jmp e_heavy
; ---- the AI -----------------------------------------------------------------
e_ai:
push 48                    ; far? walk in
load ADX
lt
jz e_close
load FACE
jz e_walk_r
load EX
push 2
sub
store EX
jmp e_done
e_walk_r:
load EX
push 2
add
store EX
jmp e_done
e_close:
load 0                     ; swing every 32 frames
push 31
and
jz e_swing
jmp e_done
e_swing:
load 0                     ; every fourth swing is the heavy: the long
shr 5                      ; wind-up the player is meant to jab through
push 3
and
push 3
eq
jz e_jab
e_heavy:
push 2
store EMV
push 26
store EP
jmp e_done
e_jab:
push 1
store EMV
push 14
store EP
e_done:

; ---- the active frame: the jab lands at 10, the heavy at 12 -----------------
load PMV
push 1
eq
jz p_act_h
load PP
push 10
eq
jz p_no_hit
push 52
store T1                   ; T1 = the move's reach
jmp p_reach
p_act_h:
load PMV
push 2
eq
jz p_no_hit
load PP
push 12
eq
jz p_no_hit
push 56
store T1
p_reach:
load ADX
load T1
lt
jz p_no_hit
load PMV                   ; a human on pad 2 can BLOCK the jab --
push 2                     ; the heavy does not ask
eq
jz p_eblk_chk
jmp p_clean
p_eblk_chk:
load P2ON
jz p_clean
load EP                    ; mid-move hands cannot block
jz p_eblk_free
jmp p_clean
p_eblk_free:
load FACE                  ; away = RIGHT when the enemy is on the right
jz p_eback_l
push 8
store T0
jmp p_eback_t
p_eback_l:
push 4
store T0
p_eback_t:
load PAD2
load T0
and
jz p_clean
load EH                    ; BLOCKED: chip, the swing spent, the ground
push 2                     ; held
sub
store EH
load PP
push 1
sub
store PP
push 3
store EFL
push 3
store HST
jmp p_no_hit
p_clean:
load EMV                   ; a hit during a WIND-UP cancels the move --
jz p_int_done              ; this is how the jab beats the heavy
load EMV
push 1
eq
jz p_int_hv
push 10
load EP
lt
jz p_int_done
jmp p_int_do
p_int_hv:
push 12
load EP
lt
jz p_int_done
p_int_do:
push 0
store EP
push 0
store EMV
p_int_done:
load PMV
push 2
eq
jz p_dmg_jab
load EH
push 20
sub
store EH
push 30
store T0                   ; T0 = knockback
jmp p_dmg_done
p_dmg_jab:
load EH
push 8
sub
store EH
push 18
store T0
p_dmg_done:
load PP                    ; the connect spends the active frame -- a
push 1                     ; frozen timer must NOT re-land the hit when
sub                        ; the hitstop lets go
store PP
push 8
store EFL
push 6
store HST
load FACE
jz p_kb_l
load EX
load T0
add
store EX
jmp p_no_hit
p_kb_l:
load EX
load T0
sub
store EX
p_no_hit:

load EMV
push 1
eq
jz e_act_h
load EP
push 10
eq
jz e_no_hit
push 52
store T1
jmp e_reach
e_act_h:
load EMV
push 2
eq
jz e_no_hit
load EP
push 12
eq
jz e_no_hit
push 56
store T1
e_reach:
load ADX
load T1
lt
jz e_no_hit
load EMV                   ; the heavy does not respect a guard
push 2
eq
jz e_blk_chk
jmp e_clean
e_blk_chk:
load PP                    ; mid-move hands cannot block
jz e_blk_free
jmp e_clean
e_blk_free:
load FACE                  ; away = LEFT when the enemy is to the right
jz e_back_r
push 4
store T0
jmp e_back_t
e_back_r:
push 8
store T0
e_back_t:
load PAD
load T0
and
jz e_clean
load PH                    ; BLOCKED: chip, a short flash, a short stop,
push 2                     ; and the ground held
sub
store PH
load EP                    ; the blocked swing is spent too
push 1
sub
store EP
push 3
store PFL
push 3
store HST
jmp e_no_hit
e_clean:
load PMV                   ; the machine's hit cancels YOUR wind-up too
jz e_int_done
load PMV
push 1
eq
jz e_int_hv
push 10
load PP
lt
jz e_int_done
jmp e_int_do
e_int_hv:
push 12
load PP
lt
jz e_int_done
e_int_do:
push 0
store PP
push 0
store PMV
e_int_done:
load EMV
push 2
eq
jz e_dmg_jab
load PH
push 20
sub
store PH
push 30
store T0
jmp e_dmg_done
e_dmg_jab:
load PH
push 8
sub
store PH
push 18
store T0
e_dmg_done:
load EP                    ; the connect spends the active frame
push 1
sub
store EP
push 8
store PFL
push 6
store HST
load FACE
jz e_kb_r
load PX
load T0
sub
store PX
jmp e_no_hit
e_kb_r:
load PX
load T0
add
store PX
e_no_hit:

; ---- KO? (a round already decided this frame stands) ------------------------
load KO
jz ko_open
jmp ph_ok
ko_open:
load EH
push 1
lt
jz eh_ok
push 1
store WIN
load PRW
push 1
add
store PRW
push 120
store KO
push 1
load PRW
lt
jz eh_ok
push 300
store KO
eh_ok:
load KO                    ; a double KO: the first verdict wins
jz ph_chk
jmp ph_ok
ph_chk:
load PH
push 1
lt
jz ph_ok
push 2
store WIN
load ERW
push 1
add
store ERW
push 120
store KO
push 1
load ERW
lt
jz ph_ok
push 300
store KO
ph_ok:

; ==== every frame: decay, clamp, draw =======================================
aftermath:
load PAD                   ; remember the pads: next frame's "fresh
store PPV                  ; press" is measured against these
load PAD2
store P2PV
load PFL
jz pfl_z
load PFL
push 1
sub
store PFL
pfl_z:
load EFL
jz efl_z
load EFL
push 1
sub
store EFL
efl_z:

load PX                    ; keep both bodies on stage
push 8
lt
jz p_cl1
push 8
store PX
p_cl1:
push 288
load PX
lt
jz p_cl2
push 288
store PX
p_cl2:
load EX
push 8
lt
jz e_cl1
push 8
store EX
e_cl1:
push 288
load EX
lt
jz e_cl2
push 288
store EX
e_cl2:

; ---- bodies ----------------------------------------------------------------
load PX
store 12303
load PX
store 12307
load PX
store 12314
load PX
push 24
add
store T0
load T0
store 12305
load T0
store 12310
load T0
store 12312
load EX
store 12317
load EX
store 12321
load EX
store 12328
load EX
push 24
add
store T0
load T0
store 12319
load T0
store 12324
load T0
store 12326

; ---- player fist: in front of the facing side, or parked --------------------
load PP
jz pf_park
load FACE
jz pf_left
load PX
push 24
add
store T0
load PX
push 48
add
store T1
load PMV                   ; the heavy reaches 8 further, and shows it
push 2
eq
jz pf_write
load T1
push 8
add
store T1
jmp pf_write
pf_left:
load PX
push 24
sub
store T0
load PX
store T1
load PMV
push 2
eq
jz pf_write
load T0
push 8
sub
store T0
jmp pf_write
pf_park:
push -100
store T0
push -76
store T1
pf_write:
load T0
store 12331
load T0
store 12335
load T0
store 12342
load T1
store 12333
load T1
store 12338
load T1
store 12340

; ---- enemy fist -------------------------------------------------------------
load EP
jz ef_park
load FACE
jz ef_right
load EX
push 24
sub
store T0
load EX
store T1
load EMV
push 2
eq
jz ef_write
load T0
push 8
sub
store T0
jmp ef_write
ef_right:
load EX
push 24
add
store T0
load EX
push 48
add
store T1
load EMV
push 2
eq
jz ef_write
load T1
push 8
add
store T1
jmp ef_write
ef_park:
push -100
store T0
push -76
store T1
ef_write:
load T0
store 12345
load T0
store 12349
load T0
store 12356
load T1
store 12347
load T1
store 12352
load T1
store 12354

; ---- health bars: width IS health -------------------------------------------
load PH
push 8
add
store T0
load T0
store 12361
load T0
store 12366
load T0
store 12368
push 312
load EH
sub
store T0
load T0
store 12373
load T0
store 12377
load T0
store 12384

; ---- the round clock: a white bar dying from both ends ----------------------
load RT
shr 6                      ; half-width, 56 pixels at a fresh minute
store T0
push 160
load T0
sub
store T1
load T1
store 12429
load T1
store 12433
load T1
store 12440
push 160
load T0
add
store T1
load T1
store 12431
load T1
store 12436
load T1
store 12438

; ---- the round pips: the match score, worn under the health bars ------------
load PRW
jz pip_p1_park
push 8
store T0
push 16
store T1
jmp pip_p1_w
pip_p1_park:
push -100
store T0
push -76
store T1
pip_p1_w:
load T0
store 12443
load T0
store 12447
load T0
store 12454
load T1
store 12445
load T1
store 12450
load T1
store 12452
push 1
load PRW
lt
jz pip_p2_park
push 20
store T0
push 28
store T1
jmp pip_p2_w
pip_p2_park:
push -100
store T0
push -76
store T1
pip_p2_w:
load T0
store 12457
load T0
store 12461
load T0
store 12468
load T1
store 12459
load T1
store 12464
load T1
store 12466
load ERW
jz pip_e1_park
push 296
store T0
push 304
store T1
jmp pip_e1_w
pip_e1_park:
push -100
store T0
push -76
store T1
pip_e1_w:
load T0
store 12471
load T0
store 12475
load T0
store 12482
load T1

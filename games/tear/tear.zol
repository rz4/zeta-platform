load T1
store 12478
load T1
store 12480
push 1
load ERW
lt
jz pip_e2_park
push 284
store T0
push 292
store T1
jmp pip_e2_w
pip_e2_park:
push -100
store T0
push -76
store T1
pip_e2_w:
load T0
store 12485
load T0
store 12489
load T0
store 12496
load T1
store 12487
load T1
store 12492
load T1
store 12494

; ---- hit flashes over whoever got tagged ------------------------------------
load PFL
jz pfla_park
load PX
push 4
sub
store T0
load PX
push 28
add
store T1
jmp pfla_write
pfla_park:
push -100
store T0
push -76
store T1
pfla_write:
load T0
store 12387
load T0
store 12391
load T0
store 12398
load T1
store 12389
load T1
store 12394
load T1
store 12396

load EFL
jz efla_park
load EX
push 4
sub
store T0
load EX
push 28
add
store T1
jmp efla_write
efla_park:
push -100
store T0
push -76
store T1
efla_write:
load T0
store 12401
load T0
store 12405
load T0
store 12412
load T1
store 12403
load T1
store 12408
load T1
store 12410

; ---- KO banner in the winner's color ----------------------------------------
load KO
jz b_park
push 100
store T0
push 220
store T1
load WIN
push 1
eq
jz b_not_p
push 0x3399FF
store 12421
push 0x3399FF
store 12428
jmp b_write
b_not_p:
load WIN
push 2
eq
jz b_gray
push 0xEE4444
store 12421
push 0xEE4444
store 12428
jmp b_write
b_gray:
push 0x888888              ; the clock ran out on a dead-even round
store 12421
push 0x888888
store 12428
jmp b_write
b_park:
push -100
store T0
push -76
store T1
b_write:
load T0
store 12415
load T0
store 12419
load T0
store 12426
load T1
store 12417
load T1
store 12422
load T1
store 12424

; ---- sound: whoosh on our swing, thud+noise on any hit, KO siren ----------
load PP                    ; ch0 pulse rises 300->950 Hz over the swing
jz snd_swing_off
push 14
load PP
sub
shl 14
push 105000
add
store 14480
push 42                    ; vol 10, duty 50%
store 14481
jmp snd_swing_done
snd_swing_off:
push 0
store 14481
snd_swing_done:

load EFL                   ; hit: triangle thud + noise crack, loud while
load PFL                   ; the flash lasts, fading with it
or
jz snd_hit_off
push 20971                 ; ~60 Hz thud
store 14484
load EFL
load PFL
or
push 6
add
store 14485
push 6291456               ; noise stepped ~18 kHz
store 14486
load EFL
load PFL
or
push 7
add
store 14487
jmp snd_hit_done
snd_hit_off:
push 0
store 14485
push 0
store 14487
snd_hit_done:

load KO                    ; KO: a siren that wobbles down the countdown
jz snd_ko_off
load KO
push 15
and
shl 14
push 175000
add
store 14482
push 24                    ; vol 8, duty 25%
store 14483
jmp snd_ko_done
snd_ko_off:
push 0
store 14483
snd_ko_done:

halt
